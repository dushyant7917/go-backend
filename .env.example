# Server Configuration
GO_ENV=local  # Options: local, dev, prod, production (determines Razorpay environment: test/live)
PORT=8080
GIN_MODE=debug

# CORS Configuration
# Comma-separated list of allowed origins. In prod, defaults to nanotv.site and krushconnect.site domains if not set.
CORS_ALLOWED_ORIGINS=url1,url2

# Encryption Configuration
# ENCRYPTION_KEY must be 16, 24, or 32 characters long (AES-128/192/256)
ENCRYPTION_KEY=change_this_to_a_strong_key

# Database Configuration
DB_HOST=your-cloud-db-host.com
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
DB_SSL_MODE=require

# AuthKey IO Configuration
AUTHKEY_API_KEY=your_authkey_api_key
AUTHKEY_TEMPLATE_ID=your_authkey_template_id

# Agora.io Configuration
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Stream Configuration
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# Test OTP Configuration (optional - for testing/development)
# When set, this phone number will always receive the specified OTP value
# SMS sending and expiry checks are disabled for this number
TEST_OTP_COUNTRY_CODE=XY
TEST_OTP_PHONE=9999999999
TEST_OTP_VALUE=1234

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# R2 Bucket Names
R2_DS_TEMPLATES_BUCKET_NAME=templates_bucket_name
R2_DS_USERS_BUCKET_NAME=users_bucket_name  # User-related files (profile pictures, etc.) for DailyStory (private)
R2_DS_POSTERS_BUCKET_NAME=posters_bucket_name
R2_CC_USERS_BUCKET_NAME=cc_users_bucket_name  # User-related files for CrushConnect
R2_CHEMISTRY_BUCKET_NAME=chemistry_bucket_name  # User-related files (profile pictures, etc.) for Chemistry (public)

# R2 Public Base URLs (for public bucket access)
R2_DS_TEMPLATES_PUBLIC_URL=https://pub-xxxxx.r2.dev  # Public URL for templates bucket
R2_DS_POSTERS_PUBLIC_URL=https://pub-yyyyy.r2.dev   # Public URL for posters bucket
R2_CHEMISTRY_PUBLIC_URL=https://pub-zzzzz.r2.dev   # Public URL for Chemistry bucket (profile pictures)
