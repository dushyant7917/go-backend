# Cron Jobs Configuration Examples
# 
# To edit your crontab, run: crontab -e
# To view your current crontab, run: crontab -l
#
# Each line represents a cron job with the following format:
# ┌───────────── minute (0 - 59)
# │ ┌───────────── hour (0 - 23)
# │ │ ┌───────────── day of month (1 - 31)
# │ │ │ ┌───────────── month (1 - 12)
# │ │ │ │ ┌───────────── day of week (0 - 6) (Sunday=0)
# │ │ │ │ │
# * * * * * command to execute

# ----- DailyStory Push Notification Examples -----

# Send daily reminder at 9:00 AM for DailyStory new users without active subscription
0 9 * * * cd /Users/dushyant7917/D7/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass go run cron-jobs/send_dailystory_push_notification/main.go

# Send notification every day at 8:00 PM
0 20 * * * cd /Users/dushyant7917/D7/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass go run cron-jobs/send_dailystory_push_notification/main.go

# Send notification every Monday at 10:00 AM
0 10 * * 1 cd /Users/dushyant7917/D7/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass go run cron-jobs/send_dailystory_push_notification/main.go

# Send notification every hour (on the hour)
0 * * * * cd /Users/dushyant7917/D7/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass go run cron-jobs/send_dailystory_push_notification/main.go

# Send notification every 30 minutes
*/30 * * * * cd /Users/dushyant7917/D7/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass go run cron-jobs/send_dailystory_push_notification/main.go

# Send notification at 9 AM, 2 PM, and 7 PM daily
0 9,14,19 * * * cd /Users/dushyant7917/D7/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass go run cron-jobs/send_dailystory_push_notification/main.go

# ----- RSS News Feed Parser Examples -----

# Parse RSS news feeds every hour
0 * * * * cd /Users/dushyant7917/D7/go-backend && go run cron-jobs/parse_news_rss/main.go >> /var/log/rss-news.log 2>&1

# Parse RSS news feeds daily at 6:00 AM and 6:00 PM
0 6,18 * * * cd /Users/dushyant7917/D7/go-backend && go run cron-jobs/parse_news_rss/main.go >> /var/log/rss-news.log 2>&1

# ----- Cleanup Orphaned Profile Pictures Examples -----

# Run cleanup scan every Sunday at 2:00 AM
0 2 * * 0 cd /Users/dushyant7917/D7/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass R2_ACCOUNT_ID=your_account_id R2_ACCESS_KEY_ID=your_key R2_SECRET_ACCESS_KEY=your_secret R2_DS_USERS_BUCKET_NAME=dailystory-users go run cron-jobs/cleanup_orphan_profile_pictures.go >> /var/log/cleanup-orphans.log 2>&1

# Run cleanup scan on the 1st of every month at 3:00 AM (using compiled binary)
0 3 1 * * cd /Users/dushyant7917/D7/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass R2_ACCOUNT_ID=your_account_id R2_ACCESS_KEY_ID=your_key R2_SECRET_ACCESS_KEY=your_secret R2_DS_USERS_BUCKET_NAME=dailystory-users ./cron-jobs/cleanup_orphan_profile_pics >> /var/log/cleanup-orphans.log 2>&1

# ----- Production Configuration -----
# For production, use the production database credentials:
# 0 9 * * * cd /Users/dushyant7917/D7/go-backend && DB_HOST=prod-db.example.com DB_USER=produser DB_PASSWORD=yourpass DB_NAME=production go run cron-jobs/send_dailystory_push_notification/main.go

# ----- Using Compiled Binary (Recommended for Production) -----
# Compile once: go build -o cron-jobs/send_dailystory_push_notification_bin cron-jobs/send_dailystory_push_notification/main.go
# Then use the binary in cron:
# 0 9 * * * cd /Users/dushyant7917/D7/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass ./cron-jobs/send_dailystory_push_notification_bin

# ----- Tips -----
# 1. Always use absolute paths in cron jobs
# 2. Set environment variables (like DB_HOST, DB_PASSWORD) before the command
# 3. Redirect output to log files for debugging:
#    0 9 * * * cd /path/to/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass ./cron-jobs/send_dailystory_push_notification_bin >> /var/log/cron-push.log 2>&1
# 4. Test your script manually before adding to crontab
# 5. Use tools like https://crontab.guru/ to validate cron expressions
# 6. For security, consider using a .env file or secret management system for DB_PASSWORD

# ----- Recurring Payment Cron Jobs -----

# Cron A: Process NEW billing cycles (every hour)
# Finds recurring payments where next_charge_at is 48-72 hours away and latest billing cycle is paid
# Creates new billing cycle, payment attempt, and sends pre-debit notification via Razorpay order
0 * * * * cd /Users/dushyant7917/D7/go-backend && go run cron-jobs/process_new_billing_cycles/main.go >> /var/log/process-new-billing-cycles.log 2>&1

# Cron B: Retry FAILED billing cycles (every hour)
# Finds billing cycles with pending status and next_attempt_at 48-72 hours away, max 8 attempts
# Creates new payment attempt and sends notification for retry
0 * * * * cd /Users/dushyant7917/D7/go-backend && go run cron-jobs/retry_failed_billing_cycles/main.go >> /var/log/retry-failed-billing-cycles.log 2>&1

# Cron C: Charge PENDING PAYMENTS via SDK (every hour)
# Finds payment attempts in created/pending state created 25+ hours ago
# Creates recurring payment via Razorpay SDK to charge the user
0 * * * * cd /Users/dushyant7917/D7/go-backend && go run cron-jobs/charge_pending_payments/main.go >> /var/log/charge-pending-payments.log 2>&1

# Cron D: RECONCILE payments with Razorpay (every hour)
# Fetches payment/order status from Razorpay for pending attempts created 24+ hours ago
# Syncs local state to handle missed webhook events
0 * * * * cd /Users/dushyant7917/D7/go-backend && go run cron-jobs/reconcile_payments/main.go >> /var/log/reconcile-payments.log 2>&1
