# Cron Jobs Configuration Examples
# 
# To edit your crontab, run: crontab -e
# To view your current crontab, run: crontab -l
#
# Each line represents a cron job with the following format:
# ┌───────────── minute (0 - 59)
# │ ┌───────────── hour (0 - 23)
# │ │ ┌───────────── day of month (1 - 31)
# │ │ │ ┌───────────── month (1 - 12)
# │ │ │ │ ┌───────────── day of week (0 - 6) (Sunday=0)
# │ │ │ │ │
# * * * * * command to execute

# ----- Push Notification Examples -----

# Send daily reminder at 9:00 AM for dailystory app
0 9 * * * cd /Users/dushyant7917/D7/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass go run cron-jobs/send_push_notification.go dailystory

# Send notification every day at 8:00 PM for crushconnect app
0 20 * * * cd /Users/dushyant7917/D7/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass go run cron-jobs/send_push_notification.go crushconnect

# Send notification every Monday at 10:00 AM
0 10 * * 1 cd /Users/dushyant7917/D7/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass go run cron-jobs/send_push_notification.go dailystory

# Send notification every hour (on the hour)
0 * * * * cd /Users/dushyant7917/D7/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass go run cron-jobs/send_push_notification.go dailystory

# Send notification every 30 minutes
*/30 * * * * cd /Users/dushyant7917/D7/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass go run cron-jobs/send_push_notification.go dailystory

# Send notification at 9 AM, 2 PM, and 7 PM daily
0 9,14,19 * * * cd /Users/dushyant7917/D7/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass go run cron-jobs/send_push_notification.go dailystory

# ----- RSS News Feed Parser Examples -----

# Parse RSS news feeds every hour
0 * * * * cd /Users/dushyant7917/D7/go-backend && go run cron-jobs/parse_news_rss/main.go >> /var/log/rss-news.log 2>&1

# Parse RSS news feeds daily at 6:00 AM and 6:00 PM
0 6,18 * * * cd /Users/dushyant7917/D7/go-backend && go run cron-jobs/parse_news_rss/main.go >> /var/log/rss-news.log 2>&1

# ----- Cleanup Orphaned Profile Pictures Examples -----

# Run cleanup scan every Sunday at 2:00 AM
0 2 * * 0 cd /Users/dushyant7917/D7/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass R2_ACCOUNT_ID=your_account_id R2_ACCESS_KEY_ID=your_key R2_SECRET_ACCESS_KEY=your_secret R2_DS_USERS_BUCKET_NAME=dailystory-users go run cron-jobs/cleanup_orphan_profile_pictures.go >> /var/log/cleanup-orphans.log 2>&1

# Run cleanup scan on the 1st of every month at 3:00 AM (using compiled binary)
0 3 1 * * cd /Users/dushyant7917/D7/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass R2_ACCOUNT_ID=your_account_id R2_ACCESS_KEY_ID=your_key R2_SECRET_ACCESS_KEY=your_secret R2_DS_USERS_BUCKET_NAME=dailystory-users ./cron-jobs/cleanup_orphan_profile_pics >> /var/log/cleanup-orphans.log 2>&1

# ----- Production Configuration -----
# For production, use the production database credentials:
# 0 9 * * * cd /Users/dushyant7917/D7/go-backend && DB_HOST=prod-db.example.com DB_USER=produser DB_PASSWORD=yourpass DB_NAME=production go run cron-jobs/send_push_notification.go dailystory

# ----- Using Compiled Binary (Recommended for Production) -----
# Compile once: go build -o cron-jobs/push_notifier cron-jobs/send_push_notification.go
# Then use the binary in cron:
# 0 9 * * * cd /Users/dushyant7917/D7/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass ./cron-jobs/push_notifier dailystory

# ----- Tips -----
# 1. Always use absolute paths in cron jobs
# 2. Set environment variables (like DB_HOST, DB_PASSWORD) before the command
# 3. Redirect output to log files for debugging:
#    0 9 * * * cd /path/to/go-backend && DB_HOST=localhost DB_PASSWORD=yourpass ./cron-jobs/push_notifier dailystory >> /var/log/cron-push.log 2>&1
# 4. Test your script manually before adding to crontab
# 5. Use tools like https://crontab.guru/ to validate cron expressions
# 6. For security, consider using a .env file or secret management system for DB_PASSWORD
